server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Erlaubt größere Datei-Uploads (z. B. STIX Bundles)
    client_max_body_size 50M;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Proxy zu Identity Service
    location /api/identity/ {
        proxy_pass ${IDENTITY_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/identity {
        return 308 /api/identity/;
    }

    # Proxy zu Aggregator Service
    location /api/aggregator/ {
        proxy_pass ${AGGREGATOR_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/aggregator {
        return 308 /api/aggregator/;
    }

    # Proxy zu Incident Manager Service
    location /api/incident-manager/ {
        proxy_pass ${INCIDENT_MANAGER_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/incident-manager {
        return 308 /api/incident-manager/;
    }

    # Proxy zu STIX Ingest Service
    location /api/stix/ {
        proxy_pass ${STIX_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/stix {
        return 308 /api/stix/;
    }
}

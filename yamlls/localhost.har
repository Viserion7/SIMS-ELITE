            "mimeType": "text/javascript",
            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_AGGREGATOR_URL\": \"http://localhost:88\", \"VITE_IDENTITY_URL\": \"http://localhost:67\", \"VITE_INCIDENT_MANAGER_URL\": \"http://localhost:420\", \"VITE_STIX_URL\": \"http://localhost:8080\"};const runtimeConfig = typeof window !== \"undefined\" ? window.APP_CONFIG ?? {} : {};\nexport const identityUrl = runtimeConfig.identityUrl || import.meta.env.VITE_IDENTITY_URL || \"/api/identity\";\nexport const aggregatorUrl = runtimeConfig.aggregatorUrl || import.meta.env.VITE_AGGREGATOR_URL || \"/api/aggregator\";\nexport const incidentManagerUrl = runtimeConfig.incidentManagerUrl || import.meta.env.VITE_INCIDENT_MANAGER_URL || \"/api/incident-manager\";\nexport const stixUrl = runtimeConfig.stixUrl || import.meta.env.VITE_STIX_URL || \"/api/stix\";\nexport const getBaseUrl = (service) => {\n\tswitch (service) {\n\t\tcase \"identity\": return identityUrl;\n\t\tcase \"aggregator\": return aggregatorUrl;\n\t\tcase \"incidentManager\": return incidentManagerUrl;\n\t\tcase \"stix\": return stixUrl;\n\t}\n};\nexport const getApiUrl = (endpoint, service = \"aggregator\") => {\n\tconst baseUrl = getBaseUrl(service);\n\tconst path = endpoint.startsWith(\"/\") ? endpoint : `/${endpoint}`;\n\treturn `${baseUrl.replace(/\\/$/, \"\")}${path}`;\n};\nexport const getIdentityApiUrl = (endpoint) => getApiUrl(endpoint, \"identity\");\nexport const getAggregatorApiUrl = (endpoint) => getApiUrl(endpoint, \"aggregator\");\nexport const getIncidentManagerApiUrl = (endpoint) => getApiUrl(endpoint, \"incidentManager\");\nexport const getStixApiUrl = (endpoint) => getApiUrl(endpoint, \"stix\");\nexport default {\n\tidentityUrl,\n\taggregatorUrl,\n\tincidentManagerUrl,\n\tstixUrl,\n\tgetBaseUrl,\n\tgetApiUrl,\n\tgetIdentityApiUrl,\n\tgetAggregatorApiUrl,\n\tgetIncidentManagerApiUrl,\n\tgetStixApiUrl\n};\n\n//# sourceMappingURL=data:application/json;base64,
            "size": 7667,
            "mimeType": "text/javascript",
            "text": "import { useQuery, useMutation, useQueryClient } from \"/node_modules/.vite/deps/@tanstack_vue-query.js?v=fc9cabc9\";\nimport { computed, toValue } from \"/node_modules/.vite/deps/vue.js?v=175df65e\";\nimport { aggregatorApi } from \"/src/api/index.ts\";\nimport { queryKeys } from \"/src/composables/queries/queryKeys.ts\";\nexport function useIncidentsQuery(page = 0, count = 20) {\n\treturn useQuery({\n\t\tqueryKey: computed(() => queryKeys.incidents.list(toValue(page), toValue(count))),\n\t\tqueryFn: () => aggregatorApi.getIncidents(toValue(page), toValue(count))\n\t});\n}\nexport function useIncidentDetailQuery(id) {\n\treturn useQuery({\n\t\tqueryKey: computed(() => queryKeys.incidents.detail(toValue(id))),\n\t\tqueryFn: () => aggregatorApi.getIncidentById(toValue(id)),\n\t\tenabled: () => !!toValue(id)\n\t});\n}\nexport function useIncidentRelationshipsQuery(incidentId) {\n\treturn useQuery({\n\t\tqueryKey: computed(() => queryKeys.incidents.relationships(toValue(incidentId))),\n\t\tqueryFn: () => aggregatorApi.getRelationshipsByIncident(toValue(incidentId)),\n\t\tenabled: () => !!toValue(incidentId)\n\t});\n}\nexport function useRelationshipsQuery(page = 0, count = 50) {\n\treturn useQuery({\n\t\tqueryKey: computed(() => queryKeys.relationships.list(toValue(page), toValue(count))),\n\t\tqueryFn: () => aggregatorApi.getRelationships(toValue(page), toValue(count))\n\t});\n}\nexport function useCreateIncidentMutation() {\n\tconst queryClient = useQueryClient();\n\treturn useMutation({\n\t\tmutationFn: (dto) => aggregatorApi.createIncident(dto),\n\t\tonSuccess: () => {\n\t\t\tqueryClient.invalidateQueries({ queryKey: queryKeys.incidents.all });\n\t\t}\n\t});\n}\nexport function useDeleteIncidentMutation() {\n\tconst queryClient = useQueryClient();\n\treturn useMutation({\n\t\tmutationFn: (id) => aggregatorApi.deleteIncident(id),\n\t\tonSuccess: () => {\n\t\t\tqueryClient.invalidateQueries({ queryKey: queryKeys.incidents.all });\n\t\t}\n\t});\n}\nexport function useCreateRelationshipMutation() {\n\tconst queryClient = useQueryClient();\n\treturn useMutation({\n\t\tmutationFn: (dto) => aggregatorApi.createRelationship(dto),\n\t\tonSuccess: () => {\n\t\t\tqueryClient.invalidateQueries({ queryKey: queryKeys.relationships.all });\n\t\t\tqueryClient.invalidateQueries({ queryKey: queryKeys.incidents.all });\n\t\t}\n\t});\n}\n\n//# sourceMappingURL=data:application/json;base64,"

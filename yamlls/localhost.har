e: 0.75rem;\\n  color: var(--primary-color);\\n  font-weight: 600;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.25rem;\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"

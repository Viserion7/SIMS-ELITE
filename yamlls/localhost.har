            "mimeType": "text/javascript",
            "text": "import { aggregatorApiClient } from \"/src/api/client.ts\";\nexport const aggregatorApi = {\n\t// Incidents (Hinweis: Backend nutzt 0-basiertes Paging via .Skip(page * count))\n\tgetIncidents: async (page = 0, count = 20) => {\n\t\tconst res = await aggregatorApiClient(`/api/v1/Incidents/${page}/${count}`, { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tgetIncidentById: async (id) => {\n\t\tconst res = await aggregatorApiClient(`/api/v1/Incidents/${id}`, { method: \"GET\" });\n\t\treturn res;\n\t},\n\tcreateIncident: async (dto) => {\n\t\tawait aggregatorApiClient(\"/api/v1/Incidents\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto\n\t\t});\n\t},\n\tdeleteIncident: async (id) => {\n\t\tawait aggregatorApiClient(`/api/v1/Incidents/${id}`, { method: \"DELETE\" });\n\t},\n\t// Relationships (0-basiertes Paging)\n\tgetRelationships: async (page = 0, count = 50) => {\n\t\tconst res = await aggregatorApiClient(`/api/v1/Relationship/${page}/${count}`, { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tgetRelationshipById: async (id) => {\n\t\tconst res = await aggregatorApiClient(`/api/v1/Relationship/${id}`, { method: \"GET\" });\n\t\treturn res;\n\t},\n\tgetRelationshipsByIncident: async (incidentId) => {\n\t\tconst res = await aggregatorApiClient(`/api/v1/Relationship/incident/${incidentId}`, { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tcreateRelationship: async (dto) => {\n\t\tawait aggregatorApiClient(\"/api/v1/Relationship\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto\n\t\t});\n\t}\n};\n\n//# sourceMappingURL=data:application/json;base64,"

            "mimeType": "text/javascript",
            "text": "import { identityApiClient } from \"/src/api/client.ts\";\nexport const identityApi = {\n\t// Auth Endpoints\n\tlogin: async (dto) => {\n\t\tconst res = await identityApiClient(\"/api/v1/Auth/login\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto,\n\t\t\tskipAuth: true\n\t\t});\n\t\treturn res;\n\t},\n\tgetMe: async () => {\n\t\tconst res = await identityApiClient(\"/api/v1/Auth/me\", { method: \"GET\" });\n\t\treturn res;\n\t},\n\trefreshToken: async (dto) => {\n\t\tconst res = await identityApiClient(\"/api/v1/Auth/refresh\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto,\n\t\t\tskipAuth: true\n\t\t});\n\t\treturn res;\n\t},\n\tlogout: async (dto) => {\n\t\tawait identityApiClient(\"/api/v1/Auth/logout\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto\n\t\t});\n\t},\n\t// User Management\n\tgetUsers: async () => {\n\t\tconst res = await identityApiClient(\"/api/v1/User\", { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tcreateUser: async (dto) => {\n\t\tawait identityApiClient(\"/api/v1/User\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: dto\n\t\t});\n\t},\n\tgetUserById: async (id) => {\n\t\tconst res = await identityApiClient(`/api/v1/User/${id}`, { method: \"GET\" });\n\t\treturn res;\n\t},\n\tgetUserDetails: async (id) => {\n\t\tconst res = await identityApiClient(`/api/v1/User/${id}/details`, { method: \"GET\" });\n\t\treturn res;\n\t},\n\tupdateUser: async (id, dto) => {\n\t\tawait identityApiClient(`/api/v1/User/${id}`, {\n\t\t\tmethod: \"PUT\",\n\t\t\tbody: dto\n\t\t});\n\t},\n\tdeleteUser: async (id) => {\n\t\tawait identityApiClient(`/api/v1/User/${id}`, { method: \"DELETE\" });\n\t},\n\tgetUsersToNotify: async () => {\n\t\tconst res = await identityApiClient(\"/api/v1/User/toNotify\", {\n\t\t\tmethod: \"GET\",\n\t\t\tskipAuth: true\n\t\t});\n\t\treturn res ?? [];\n\t},\n\t// Categories & Assignments\n\tgetCategories: async () => {\n\t\tconst res = await identityApiClient(\"/api/v1/Categories/categories\", { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tgetLevels: async () => {\n\t\tconst res = await identityApiClient(\"/api/v1/Levels\", { method: \"GET\" });\n\t\treturn res ?? [];\n\t},\n\tassignLevel: async (userId, levelId) => {\n\t\tconst res = await identityApiClient(`/api/v1/Assignment/user/${userId}/level/${levelId}`, { method: \"POST\" });\n\t\treturn res;\n\t},\n\tremoveLevel: async (userId, levelId) => {\n\t\tconst res = await identityApiClient(`/api/v1/Assignment/user/${userId}/level/${levelId}`, { method: \"DELETE\" });\n\t\treturn res;\n\t}\n};\n\n//# sourceMappingURL=data:application/json;base64,"
